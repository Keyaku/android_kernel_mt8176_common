# clangd config for the MT8176 3.18.79 kernel.
#
# compile_commands.json in this directory is a symlink to the database generated from the
# in-tree build's .cmd files (scripts/gen_compile_commands.sh kernel). It carries the real
# include paths and defines, so no hand-maintained -isystem list is needed here.
#
# Nearly every entry is aarch64-linux-android-gcc 4.9; the flags below are the gcc-only ones
# that clangd's clang frontend rejects.
CompileFlags:
  Remove:
    - --param*
    - -fconserve-stack
    - -fno-var-tracking-assignments
    - -fno-ipa-sra
    - -frename-registers
    - -Wa,*
    - -Werror*
    - -Wframe-larger-than=*
    - -Wno-error=maybe-uninitialized
  Add:
    - -Wno-unknown-attributes
    - -Wno-unknown-warning-option
Diagnostics:
  UnusedIncludes: None
